{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Resilience": {
      "MaxRetryAttempts": 5,
      "FailureRatio": 0.3,
      "CircuitBreakDurationSeconds": 30,
      "TimeoutSeconds": 5
    }
  },
  "EventBus": {
    "EnableDeduplication": false,
    "SubscriptionClientName": "custom_masstransit",
    "RetryCount": 10

  },
  "ConnectionStrings": {
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Default": "Data Source=localhost;Initial Catalog=RabbitMqDB;Integrated Security=True;Trusted_Connection=true;TrustServerCertificate=true"
  }
}
